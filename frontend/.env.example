# Copy this file to .env.local for local development
# For Vite, all public env vars must be prefixed with VITE_

# Leave blank (or omit entirely) in local dev — Vite proxy handles /api → localhost:5000
# In production on Vercel, set this to your Render backend URL (no trailing slash):
#   VITE_API_URL=https://issueflow-backend.onrender.com
VITE_API_URL=

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files — NEVER commit real secrets
.env
.env.*
!.env.example

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Prisma generated client (regenerated via prisma generate)
backend/prisma/generated/

# Uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories and local tool config
.vscode/
.idea/
*.suo
*.user
.claude/

# Coverage reports
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp

# Copy this file to .env and fill in your values
# NEVER commit the real .env file

PORT=5000

# Local development (PostgreSQL):
#   postgresql://USER:PASSWORD@localhost:5432/issueflow_dev
# Render production:
#   Paste the "Internal Database URL" from your Render PostgreSQL service
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/issueflow_dev"

# Generate a strong random secret (minimum 32 characters):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Local dev: the Vite dev server origin
# Production (Render): your Vercel frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGIN="http://localhost:5173"
